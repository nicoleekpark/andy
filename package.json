{
  "name": "andy",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@clerk/expo": "^4.6.0",
    "@expo/ui": "~57.0.13",
    "convex": "^1.45.0",
    "expo": "~57.0.16",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.2",
    "expo-speech-recognition": "^56.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.56",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "concurrently -k -i --default-input-target expo -n convex,expo -c blue,green \"convex dev\" \"expo start --dev-client --ios\"",
    "start": "expo start --dev-client",
    "build:ios": "eas build --profile development --platform ios",
    "build:ios:device": "eas build --profile development-device --platform ios",
    "ios:install": "eas build:run --platform ios --latest",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "db": "convex dashboard",
    "lint": "expo lint convex src && tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "test": "jest && vitest run",
    "test:watch": "jest --watchAll",
    "test:watch:convex": "vitest",
    "test:convex": "vitest run",
    "test:rn": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/convex/",
      "<rootDir>/example/"
    ]
  },
  "private": true
}
